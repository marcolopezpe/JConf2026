      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "longitude",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "speedKmh",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "occurredAtEpochMillis",
      "type": ["null", "string"],
      "default": null
    }
  ]
}